# ─── Vite Frontend Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your Firebase project values.
# Get these from: Firebase Console → Project Settings → Your Apps → Web App Config
# NEVER commit .env to git — it is already in .gitignore

# ── Firebase ─────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=        # optional — Analytics

# ── Backend API base URL ─────────────────────────────────────────────────────
# Development (default used by sosService.js if this is unset)
VITE_API_URL=http://localhost:5000

# Production example:
# VITE_API_URL=https://your-backend.onrender.com
