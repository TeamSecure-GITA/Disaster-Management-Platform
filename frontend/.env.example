# API & WebSocket Configurations
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_ML_API_URL=http://localhost:8000
NEXT_PUBLIC_COPILOT_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws

# Map Configuration
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
NEXT_PUBLIC_DEFAULT_LAT=25.5788
NEXT_PUBLIC_DEFAULT_LNG=91.8933
NEXT_PUBLIC_DEFAULT_ZOOM=10

# Innovation Features & Mesh Network
NEXT_PUBLIC_ENABLE_WASM_WORKERS=true
NEXT_PUBLIC_ENABLE_P2P_MESH=true
NEXT_PUBLIC_ENABLE_AUDIO_CHIRP=true
NEXT_PUBLIC_ENABLE_PQC_ENCRYPTION=true
