# Vite exposes only variables prefixed with VITE_ to browser code.
# For a deployed frontend, set VITE_API_URL to the public backend URL.
VITE_API_URL=http://localhost:5000
VITE_ML_API_URL=http://localhost:8000
VITE_COPILOT_API_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:5000/socket.io

# Map Configuration
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
VITE_DEFAULT_LAT=25.5788
VITE_DEFAULT_LNG=91.8933
VITE_DEFAULT_ZOOM=10

# Innovation Features & Mesh Network
VITE_ENABLE_WASM_WORKERS=true
VITE_ENABLE_P2P_MESH=true
VITE_ENABLE_AUDIO_CHIRP=true
VITE_ENABLE_PQC_ENCRYPTION=true
