{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SatelliteObservationSchema",
  "description": "Validation schema for Earth observation satellite spectral products and raster tiles",
  "type": "object",
  "required": ["timestamp", "latitude", "longitude", "ndvi"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 acquisition timestamp"
    },
    "latitude": {
      "type": "number",
      "minimum": -90.0,
      "maximum": 90.0,
      "description": "Center latitude in degrees"
    },
    "longitude": {
      "type": "number",
      "minimum": -180.0,
      "maximum": 180.0,
      "description": "Center longitude in degrees"
    },
    "ndvi": {
      "type": "number",
      "minimum": -1.0,
      "maximum": 1.0,
      "description": "Normalized Difference Vegetation Index"
    },
    "ndwi": {
      "type": "number",
      "minimum": -1.0,
      "maximum": 1.0,
      "description": "Normalized Difference Water Index"
    },
    "surface_temperature": {
      "type": "number",
      "minimum": -60.0,
      "maximum": 90.0,
      "description": "Land surface temperature in Celsius"
    },
    "elevation": {
      "type": "number",
      "minimum": -500.0,
      "maximum": 9000.0,
      "description": "Digital Elevation Model height in meters"
    },
    "satellite": {
      "type": "string",
      "description": "Satellite constellation name (e.g. Sentinel-2, Landsat-8, MODIS)"
    }
  },
  "additionalProperties": true
}
