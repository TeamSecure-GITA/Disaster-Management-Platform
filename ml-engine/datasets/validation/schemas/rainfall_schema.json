{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RainfallObservationSchema",
  "description": "Validation schema for precipitation and rainfall telemetry data",
  "type": "object",
  "required": ["timestamp", "latitude", "longitude", "rainfall_mm"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 measurement timestamp"
    },
    "latitude": {
      "type": "number",
      "minimum": -90.0,
      "maximum": 90.0,
      "description": "Geographic latitude in degrees"
    },
    "longitude": {
      "type": "number",
      "minimum": -180.0,
      "maximum": 180.0,
      "description": "Geographic longitude in degrees"
    },
    "rainfall_mm": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 2000.0,
      "description": "Precipitation accumulated during period in mm"
    },
    "duration_hours": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "description": "Measurement accumulation window in hours"
    },
    "intensity": {
      "type": "number",
      "minimum": 0.0,
      "description": "Rainfall rate / intensity in mm per hour"
    }
  },
  "additionalProperties": true
}
