{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IncidentReportSchema",
  "description": "Validation schema for disaster incident reports, crowdsourced citizen inputs, and hazard events",
  "type": "object",
  "required": ["timestamp", "latitude", "longitude", "hazard_type", "severity"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 report timestamp"
    },
    "latitude": {
      "type": "number",
      "minimum": -90.0,
      "maximum": 90.0,
      "description": "Incident latitude in degrees"
    },
    "longitude": {
      "type": "number",
      "minimum": -180.0,
      "maximum": 180.0,
      "description": "Incident longitude in degrees"
    },
    "hazard_type": {
      "type": "string",
      "enum": ["landslide", "flood", "cyclone", "wildfire", "earthquake", "other"],
      "description": "Categorical hazard type"
    },
    "severity": {
      "type": "string",
      "enum": ["minor", "moderate", "severe", "critical"],
      "description": "Assessed hazard severity level"
    },
    "description": {
      "type": "string",
      "description": "Textual description of the incident"
    },
    "verified": {
      "type": "boolean",
      "description": "Whether the incident report has been confirmed by field responders"
    },
    "upvotes": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of citizen confirmations or upvotes"
    },
    "media_url": {
      "type": ["string", "null"],
      "description": "Link to verified field image or video documentation"
    },
    "reporter_id": {
      "type": ["string", "null"],
      "description": "Anonymized user ID or agency identifier"
    }
  },
  "additionalProperties": true
}
