NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/disaster_management
JWT_SECRET=your-secure-random-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# ML & AI Subsystem (FastAPI in ./ml_backend)
# Use http://localhost:8000 for local development; use http://ai-service:8000 inside Docker Compose
AI_CHATBOT_URL=http://localhost:8000
# ── Satellite Remote Sensing Providers (Real Copernicus, InSAR, & Soil Moisture APIs) ──
# 1. Copernicus Data Space Ecosystem (CDSE) - Sentinel-1 C-SAR radar & Sentinel-2 MSI optical
SATELLITE_API_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products
COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac/search
# 2. Satellite-Assimilated Soil Moisture (Open-Meteo & Copernicus ERA5-Land 0-1cm, 1-3cm, 3-9cm)
SATELLITE_SOIL_MOISTURE_API_URL=https://api.open-meteo.com/v1/forecast
# 3. NASA Earthdata CMR STAC (NASA SMAP Soil Moisture, Landsat)
NASA_CMR_STAC_URL=https://cmr.earthdata.nasa.gov/stac
WEATHER_API_KEY=
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=10485760
LOG_LEVEL=info
CLOUD_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── SMS Gateway – MSG91 (Primary, India DLT-native) ──────────────────────────
# Register at: https://msg91.com  |  DLT portal: https://dlt.trai.gov.in
MSG91_AUTH_KEY=
MSG91_SENDER_ID=NERDMP
MSG91_DLT_PE_ID=
MSG91_ROUTE=4

# ── SMS Gateway – Twilio (Global Fallback) ────────────────────────────────────
# Register at: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── SMS DLR Webhook ───────────────────────────────────────────────────────────
# Public base URL that Twilio/MSG91 will POST delivery receipts to
# e.g. https://api.nerdmp.in  (no trailing slash)
SMS_WEBHOOK_BASE_URL=
# Optional shared secret validated in X-Webhook-Secret header
SMS_WEBHOOK_SECRET=

# ── DLT-Registered Template IDs (India TRAI DLT portal) ──────────────────────
# Replace placeholder values with your approved Template IDs after registration.
DLT_TMPL_LANDSLIDE_CRITICAL_EN=1234567890123456789
DLT_TMPL_LANDSLIDE_CRITICAL_HI=1234567890123456780
DLT_TMPL_LANDSLIDE_CRITICAL_AS=1234567890123456781
DLT_TMPL_LANDSLIDE_CRITICAL_BN=1234567890123456782
DLT_TMPL_LANDSLIDE_CRITICAL_NE=1234567890123456783
DLT_TMPL_LANDSLIDE_HIGH_EN=1234567890123456784
DLT_TMPL_LANDSLIDE_HIGH_HI=1234567890123456785
DLT_TMPL_LANDSLIDE_HIGH_AS=1234567890123456786
DLT_TMPL_LANDSLIDE_HIGH_BN=1234567890123456787
DLT_TMPL_LANDSLIDE_HIGH_NE=1234567890123456788
DLT_TMPL_GENERIC_EN=1234567890123456789
DLT_TMPL_GENERIC_HI=1234567890123456790
DLT_TMPL_OPTIN_EN=1234567890123456791
DLT_TMPL_OPTOUT_EN=1234567890123456792